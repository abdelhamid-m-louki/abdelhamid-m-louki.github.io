# ============================================================
# Variables d'environnement — Backend Vercel
# Copier vers .env.local pour le dev, ou définir dans
# Vercel Dashboard → Settings → Environment Variables.
# JAMAIS de clé secrète dans le code ni dans le frontend.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (proxy /api/ia) ---
GEMINI_KEY=
OPENAI_KEY=

# --- Contact (Resend → /api/contact) ---
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM=le site <onboarding@resend.dev>
SITE_NAME=le site

# --- CORS (origines autorisées, séparées par des virgules) ---
ALLOWED_ORIGINS=https://votre-domaine.fr,https://www.votre-domaine.fr,http://localhost:3000

# --- Seed (node supabase/seed.mjs) : compte admin Supabase Auth ---
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur
